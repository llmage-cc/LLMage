syntax: glob

# global files
# Runtime H2 card databases: the engine opens ./db, the WebProxy opens
# Mage.WebProxy/db. Ignore the database files, not every directory named "db" —
# Mage.Common/src/main/java/mage/db is a Java package.
*.h2.db
*.h2.mv.db
*.h2.trace.db
*.trace.db
*.lock.db
# Tracked test fixture (schema/card sample), not a runtime database
!Mage.Tests/src/test/data/users-db-sample.h2.mv.db
**/saved
**/target
#un-ignore target implementations
!Mage/src/main/java/mage/target

# logs and logs rotation
*.log
*.log.*
*/gamelogs
*/gamelogsJson
*/gamesHistory

# Mage.Client
Mage.Client/plugins/images
Mage.Client/plugins/plugin.data
# TODO: must save serverlist.txt to temporary files, not root folder
Mage.Client/serverlist.txt

# Mage.Server
Mage.Server/config/init.txt
Mage.Server/extensions

# Mage.Verify
# downloadable files
Mage.Verify/*.zip
Mage.Verify/*.json

# Utils
__pycache__
Utils/data/*
!Utils/data/.gitkeep

# dev environments, IDE and OS
# IntelliJ IDEA
.idea
*.iml
# Visual Studio Code
.vscode
.history
# Eclipse
.metadata
.project
.settings
.factorypath
**/bin
**/out
# NetBeans
**/nb-configuration.xml
# Atom
.build-tools.cson
# mac os
.DS_Store

# build tools
mage-bundle.zip
Mage.WebProxy/dist/
.env

# build targets
/deploy
/temp

# dev tools
.devcontainer/**/*lock.json

# LLM plugin — generated dirs and artifacts
# JARs deployed in place by scripts/deploy-release.sh. The rest of
# Mage.Client/release/ and Mage.Server/release/ is shipped source: launchers,
# config, backgrounds and the sample decks. Scope the ignore to the output
# directories so tracked sources below them stay visible to contributors.
Mage.Client/release/lib/
Mage.Server/release/lib/
Mage.Server/release/plugins/
# Server plugin drop dir at the repo root (Mage.Client/plugins and every Java
# package named plugins must stay visible)
/plugins/
gamelogs/
gamelogsJson/
# Local Message-of-the-Day override at the repo root; the shipped copy in
# Mage.Server/release/server.msg.txt is tracked
/server.msg.txt

# Local TODO tracking (not committed)
TODO.md
WEB-CLIENT-RESEARCH.md

# Stray compiled class files in root (javac without -d). Match only .class
# files so the rule cannot fold onto the Mage/ source tree on the
# case-insensitive filesystems macOS and Windows use.
/*.class
/mage/**/*.class

# React frontend — node_modules and build artifacts
# index.html is generated by the Vite build into this directory; the source of
# truth is react/src (see react/src/main.tsx)
Mage.WebProxy/web/frontend/index.html
Mage.WebProxy/web/frontend/react/node_modules/
Mage.WebProxy/web/frontend/assets/

# Local agent scratch files
.hermes/

# Rotated log archives + game transcripts (tracked history kept; NEW files go to a
# separate data repository, not git — see "The data")
oldlogs/
oldlogs+saves/
scripts/.serial-oracle-cp.txt
# JVM-oracle scratch build output (regenerated by the check scripts)
scripts/.SerialOracle.bin/
scripts/.SerialSaveScope.bin/
